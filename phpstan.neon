includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    paths:
        - app
        - config
        - routes
    level: 6
    ignoreErrors:
        # Kaynak TS semalarindan gelen serbest diziler: sekil Z semalariyla dogrulanir.
        - identifier: missingType.iterableValue
        - identifier: argument.templateType
