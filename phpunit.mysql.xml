<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/mysql-bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Mysql"><directory>tests/Mysql</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="CACHE_STORE" value="database"/>
        <env name="CACHE_LIMITER_STORE" value="database"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PUBLIC_WEB_ORIGIN" value="https://otosanayide.test"/>
        <env name="MOBILE_WEB_ORIGIN" value="https://m.otosanayide.test"/>
        <!-- Baglanti bilgileri tests/mysql-bootstrap.php ile .env dosyasindan gelir. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="otosanayide_test" force="true"/>
    </php>
</phpunit>
