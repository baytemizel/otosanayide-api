APP_NAME=Otosanayide
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Sunucuda /etc/otosanayide/mysql.env degerlerinden doldurulur; depoya girmez.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33066
DB_DATABASE=otosanayide
DB_USERNAME=
DB_PASSWORD=
# Yalniz migrate: /etc/otosanayide/mysql-migrator.cnf
DB_MIGRATOR_CNF=

# TLS kullanilacaksa CA dosyasinin yolu
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Eposta saglayicisi secilmedi (MAIL-01): yerelde log surucusu.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Zorunlu: beklenen web origin'i. Host basligina guvenilmez.
PUBLIC_WEB_ORIGIN=http://localhost:3000
MOBILE_WEB_ORIGIN=
# Isletme portali (Sozlesme Eki v1); bos: portal tarayicidan API'yi cagiramaz. Yonetici uclari portala kapali.
PORTAL_WEB_ORIGIN=http://localhost:3001
# Cloudflare IPv4/IPv6 CIDR listesi, virgulle (K179). Bos: proxy'ye guvenilmez.
TRUSTED_PROXIES=

# Ozellik bayraklari varsayilan kapali; yalniz tam olarak "true" acar.
SHARED_GARAGE_ENABLED=false
MOBILE_GARAGE_BACKUP_ENABLED=false
DATA_REQUESTS_ENABLED=false
PUSH_DELIVERY_ENABLED=false
REVIEW_PHOTOS_ENABLED=false
BUSINESS_PHOTOS_ENABLED=false
CLAIM_EVIDENCE_ENABLED=false
GOOGLE_PLACES_ENABLED=false
AI_MODERATION_ENABLED=false
AD_SERVING_ENABLED=false
AD_METRICS_ENABLED=false
AD_RESERVATIONS_ENABLED=false
BRAND_ORDERS_ENABLED=false
BRAND_METRICS_ENABLED=false
BRAND_CANCELLATIONS_ENABLED=false
BRAND_RESERVATIONS_ENABLED=false
BRAND_REFUND_REVIEW_ENABLED=false
BRAND_PREVIEW_ENABLED=false
BRAND_MEDIA_ENABLED=false
BRAND_ACCEPTANCE_ENABLED=false
BRAND_SERVING_ENABLED=false
PAYMENTS_ENABLED=false
PUSH_PUBLIC_APP_IDS=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
MODERATION_EXTRA_TERMS=

# Zamanlanmis yazicilar
REQUEST_NOTIFICATIONS_WORKER_ENABLED=false
GARAGE_RECYCLE_PURGE_ENABLED=false
REMINDER_INBOX_WORKER_ENABLED=false
REMINDER_EMAIL_WORKER_ENABLED=false
REMINDER_PUSH_WORKER_ENABLED=false
# Hatirlatma e-postasi saglayici bayragi (MAIL-01 secilmeden acilmaz)
EMAIL_DELIVERY_ENABLED=false

# Push gonderimi (docs/PUSH_API.md). log: saglayiciya baglanmaz, uretimde reddedilir. live: apns/fcm.
PUSH_DRIVER=log
# Sunucudaki dosya yollari (0600); anahtar icerigi buraya yazilmaz.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=
